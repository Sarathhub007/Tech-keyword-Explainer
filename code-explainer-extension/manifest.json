{
  "manifest_version": 3,
  "name": "CodeWord Explainer",
  "version": "1.0.0",
  "description": "Double-click any programming keyword or coding concept on any webpage to instantly see explanations, syntax examples, and docs.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CodeWord Explainer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/dictionary.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "test-page.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
